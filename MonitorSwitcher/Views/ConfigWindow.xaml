<Window x:Class="MonitorSwitcher.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Monitors — Monitor Input Switcher"
        Width="500" Height="560"
        MinWidth="460" MinHeight="350"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <!-- Footer buttons — always visible at bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button Content="Save" Padding="16,6"
                    Click="Save_Click"/>
        </StackPanel>

        <!-- Config file path -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Open Folder" DockPanel.Dock="Right"
                    Click="OpenConfigFolder_Click"
                    Padding="8,2" Margin="8,0,0,0"
                    ToolTip="Open the folder with config.json and monitor-switcher.log"/>
            <TextBlock x:Name="ConfigPathText"
                       VerticalAlignment="Center" FontSize="11" Foreground="Gray"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Monitors and presets — scrollable -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl x:Name="MonitorList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDDDDD" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <!-- Monitor header -->
                                    <DockPanel Margin="0,0,0,4">
                                        <Button Content="🖥 Identify"
                                                DockPanel.Dock="Right"
                                                Tag="{Binding}"
                                                Click="Identify_Click"
                                                Padding="8,2"
                                                ToolTip="Show an overlay on this monitor to identify it"/>
                                        <TextBlock Text="{Binding HeaderText}"
                                                   FontSize="10" Foreground="Gray"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Display name + hidden toggle -->
                                    <DockPanel Margin="0,0,0,8">
                                        <CheckBox Content="Hidden"
                                                  DockPanel.Dock="Right"
                                                  IsChecked="{Binding IsDisabled}"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  ToolTip="Hide this monitor from the main window"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Name: "
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="260"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Inputs header + detect button -->
                                    <DockPanel Margin="0,0,0,4">
                                        <Button Content="&#x1f50d; Detect Inputs"
                                                DockPanel.Dock="Right"
                                                Tag="{Binding}"
                                                Click="Detect_Click"
                                                Padding="8,2"
                                                ToolTip="Ask the monitor which inputs it has and add any that are missing, including ones you removed"/>
                                        <TextBlock Text="Inputs:" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Input rows -->
                                    <ItemsControl ItemsSource="{Binding Inputs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             Width="150" Margin="0,0,4,0"
                                                             ToolTip="Edit label"/>
                                                    <TextBlock Text="{Binding VcpDisplay}"
                                                               VerticalAlignment="Center"
                                                               Width="60" Margin="0,0,6,0"
                                                               Foreground="Gray" FontSize="11"/>
                                                    <Button Content="▲" FontSize="10"
                                                            Tag="{Binding}"
                                                            Click="MoveUp_Click"
                                                            Padding="4,2" Margin="0,0,2,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Move up"/>
                                                    <Button Content="▼" FontSize="10"
                                                            Tag="{Binding}"
                                                            Click="MoveDown_Click"
                                                            Padding="4,2" Margin="0,0,4,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Move down"/>
                                                    <Button Content="✕"
                                                            Tag="{Binding}"
                                                            Click="RemoveInput_Click"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Remove. It won't be added back automatically; Detect Inputs restores it."/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Add input — known input dropdown -->
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,6,0,0">
                                        <TextBlock Text="Add:" VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ComboBox Tag="{Binding}"
                                                  Width="220" Margin="0,0,6,0"
                                                  DisplayMemberPath="DisplayText"
                                                  Loaded="AddInputCombo_Loaded"/>
                                        <Button Content="+ Add"
                                                Padding="8,2"
                                                Click="AddInputPreset_Click"/>
                                    </StackPanel>

                                    <!-- Add input — manual VCP entry -->
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0"
                                                Tag="{Binding}">
                                        <TextBlock Text="Manual:" VerticalAlignment="Center"
                                                   Margin="0,0,6,0" Width="42"/>
                                        <TextBox Width="120"
                                                 Margin="0,0,4,0"
                                                 ToolTip="Label (e.g. HDMI-3)"/>
                                        <TextBox Width="50"
                                                 Margin="0,0,4,0"
                                                 ToolTip="VCP value (0-255, or hex like 0x0F)"/>
                                        <Button Content="+ Add"
                                                Padding="8,2"
                                                Click="AddManual_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Presets: switch several monitors with one click -->
                <Border BorderBrush="#DDDDDD" BorderThickness="1"
                        CornerRadius="4" Margin="0,0,0,10" Padding="10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <Button Content="+ Add Preset"
                                    DockPanel.Dock="Right"
                                    Click="AddSwitchPreset_Click"
                                    Padding="8,2"/>
                            <TextBlock Text="Presets" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Switch several monitors with one click, e.g. all of them to your laptop. Presets show up as buttons at the top of the main window."
                                   TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                   Margin="0,0,0,6"/>

                        <ItemsControl x:Name="PresetList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEEEEE" BorderThickness="0,1,0,0"
                                            Padding="0,8,0,2">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button Content="✕"
                                                        DockPanel.Dock="Right"
                                                        Tag="{Binding}"
                                                        Click="RemoveSwitchPreset_Click"
                                                        Padding="6,2"
                                                        ToolTip="Remove preset"/>
                                                <TextBlock Text="Name: "
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="200"
                                                         HorizontalAlignment="Left"/>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Targets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <ComboBox DockPanel.Dock="Right"
                                                                      Width="170"
                                                                      ItemsSource="{Binding Options}"
                                                                      SelectedItem="{Binding Selected}"
                                                                      DisplayMemberPath="Label"/>
                                                            <TextBlock Text="{Binding Monitor.DisplayName}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0,8,0"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
