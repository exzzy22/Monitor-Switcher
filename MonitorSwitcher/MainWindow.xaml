<Window x:Class="MonitorSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MonitorSwitcher.Converters"
        Title="Monitor Input Switcher"
        Width="420" SizeToContent="Height"
        ResizeMode="CanMinimize"
        Topmost="{Binding IsTopMost, Mode=TwoWay}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Input button style with proper active/inactive/disabled states -->
        <Style x:Key="InputButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#E8E8E8"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                            <!-- Active input -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2979FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <!-- Disabled (switching, or monitor not connected) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square header button (refresh, stay on top) -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#E8E8E8"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#2979FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Command="{Binding ToggleTopMostCommand}"
                    DockPanel.Dock="Right"
                    Content="&#xE718;"
                    ToolTip="Stay on top"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTopMost}" Value="True">
                                <Setter Property="Tag" Value="Active"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding RefreshCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource HeaderButtonStyle}"
                    ToolTip="Refresh monitors and current inputs"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinRefreshIcon">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1"
                                                                 RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinRefreshIcon"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <TextBlock Text="Monitors"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Presets: switch several monitors with one click -->
        <Border Grid.Row="1"
                BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="6" Margin="0,0,0,8" Padding="12,10,12,6"
                Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                  Opacity="0.15" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Presets"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding ApplyCommand}"
                                    ToolTip="{Binding ToolTip}"
                                    Style="{StaticResource InputButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Monitor cards -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Monitors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDDDDD" BorderThickness="1"
                            CornerRadius="6" Margin="0,0,0,8"
                            Padding="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                              Opacity="0.15" Color="Black"/>
                        </Border.Effect>

                        <StackPanel>
                            <!-- Monitor name -->
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,4"/>

                            <!-- Current input -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Current input: "
                                           Foreground="Gray"/>
                                <TextBlock Text="{Binding CurrentInputLabel}"
                                           FontWeight="Medium"/>
                                <TextBlock Text="  ·  switching…"
                                           FontStyle="Italic" Foreground="#FF6600"
                                           Visibility="{Binding IsSwitching, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>

                            <!-- Input buttons -->
                            <ItemsControl ItemsSource="{Binding Inputs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                Command="{Binding DataContext.SetInputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource InputButtonStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- No inputs configured message -->
                            <TextBlock Text="No inputs configured. Click Configure to set up."
                                       Foreground="Orange" FontStyle="Italic"
                                       Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Inputs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Last error / connection status -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="#C62828"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2"
                   Text="No monitors to show. Click refresh, or open Configure to un-hide monitors."
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,8"
                   Visibility="{Binding ShowNoMonitorsMessage, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Configure..."
                    Command="{Binding ConfigureCommand}"
                    Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
